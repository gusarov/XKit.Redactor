<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Description>Entropy-based IRedactor: finds secrets in text whose shape is unknown by dropping dictionary words and measuring what is left. Carries an embedded English + developer word list.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\"/>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XKit.Redactor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XKit.Redactor\XKit.Redactor.csproj" />
  </ItemGroup>

</Project>
